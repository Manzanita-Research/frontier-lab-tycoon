        {
          "id": "mea-convening",
          "stripe": "Invitation · RSVP by midnight",
          "tone": "neutral",
          "cooldown": 0,
          "when": {"flag": "mea:never", "daysAgo": 0},
          "title": "You're invited to the Convening at Utilsbury Manor.",
          "body": "The Maximally Effective Altruists are convening this weekend and {lab} is on the list. The invitation is a spreadsheet. It has a tab called Rooming (Fluid), a tab called Hot Tub Rota, and a tab that just says Vibes.",
          "choices": [
            {"label": "Attend the Convening", "hint": "Vibes +60 · Hype +8 · bring a towel", "effects": []},
            {"label": "Run the numbers first", "hint": "Vibes +20 · Hype +3 · the model says go, with error bars", "effects": []},
            {"label": "Decline (your EV drops)", "hint": "Vibes −40 · Hype −4 · they will tell you by how much", "effects": []}
          ]
        },
        {
          "id": "mea-leak",
          "kind": "drama",
          "stripe": "Leaked · group chat → Bird App",
          "tone": "bad",
          "cooldown": 0,
          "when": {"flag": "mea:never", "daysAgo": 0},
          "title": "Someone leaked the Convening's Sankey chart.",
          "body": "It went from a private channel to the Bird App in fourteen minutes. The Hot Tub band is the widest thing on it, and {lab} is on it too. Trust is down.",
          "doc": {
            "style": "sankey",
            "app": "Sankey Panky 95",
            "file": "Retreat Attendance Flow (FINAL_v7).sankey",
            "subject": "The Convening at Utilsbury Manor: who went where, weighted in expected hugs",

            {"label": "Send it", "hint": "Trust +4 · Hype −2 · it reads like a statement", "effects": []},
            {"label": "Add a footnote", "hint": "Trust +2 · Hype +3 · the footnote has a footnote", "effects": []},
            {"label": "Let Comms log off", "hint": "Vibes +40 · Trust −3 · the statement goes out as a Sankey", "effects": []}
          ]
        }

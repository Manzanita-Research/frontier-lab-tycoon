            "columns": ["Who", "Breakout session", "Ended up in"],
            "nodes": [
              {"id": "clementine", "label": "Clementine", "sub": "Moral Weights Lead"},
              {"id": "barnaby", "label": "Barnaby", "sub": "Head of Longtermism"},
              {"id": "ottoline", "label": "Ottoline", "sub": "Chief of Staff (Vibes)"},
              {"id": "rafferty", "label": "Rafferty", "sub": "Forecasting Lead"},
              {"id": "persephone", "label": "Persephone", "sub": "Expected Value Officer"},
              {"id": "dashiell", "label": "Dashiell", "sub": "Head of Spreadsheets"},
              {"id": "lab", "label": "{lab}", "sub": "Delegation of two"},
              {"id": "circle", "label": "Moral Circle Expansion", "sub": "facilitated"},

    "arcs": {
      "add": [
        {
          "id": "mea-story",
          "requires": ["events"],
          "initial": "waiting",
          "states": {
            "waiting": {
              "on": {"DAY": {"target": "arrival", "guard": {"type": "after", "params": {"days": 3}}}}
            },
            "arrival": {
              "entry": [
                {"type": "building.ensure", "params": {"kind": "manor", "text": "The Maximally Effective Altruists have bought the manor next door. They say it's for convening."}},
                {"type": "news", "params": {"text": "Maximally Effective Altruists buy Utilsbury Manor \"for convening\"; purchase justified by a 41-tab spreadsheet", "tone": "joke"}},
                {"type": "camera.focus", "params": {"on": "manor", "zoom": 1.6, "hold": 3}}
              ],
              "on": {"DAY": {"target": "invited", "guard": {"type": "after", "params": {"days": 2}}}}
            },
            "invited": {
              "entry": [
                {"type": "building.ensure", "params": {"kind": "manor"}},
                {"type": "card", "params": {"id": "mea-convening"}},
                {"type": "sound.cue", "params": {"cue": "card"}}
              ],
              "on": {
                "CHOSE": [
                  {
                    "target": "packing",
                    "guard": {"type": "choice", "params": {"is": "0", "card": "mea-convening"}},
                    "actions": [
                      {"type": "vibes.delta", "params": {"amount": 60}},
                      {"type": "hype.delta", "params": {"amount": 8}},
                      {"type": "toast", "params": {"text": "Your delegation packs for the Convening. The packing list is nine pages; page seven is just towels.", "tone": "joke"}}
                    ]
                  },
                  {
                    "target": "packing",
                    "guard": {"type": "choice", "params": {"is": "1", "card": "mea-convening"}},
                    "actions": [
                      {"type": "vibes.delta", "params": {"amount": 20}},
                      {"type": "hype.delta", "params": {"amount": 3}},
                      {"type": "toast", "params": {"text": "You ran the numbers. The model says Attend, with an expected value of \"yes\". Persephone forecast that you'd ask.", "tone": "joke"}}
                    ]
                  },
                  {
                    "target": "packing",
                    "guard": {"type": "choice", "params": {"is": "2", "card": "mea-convening"}},
                    "actions": [
                      {"type": "vibes.delta", "params": {"amount": -40}},
                      {"type": "hype.delta", "params": {"amount": -4}},
                      {"type": "toast", "params": {"text": "Declined. Clementine has updated your EV downward by 0.3 utils, and says it with love.", "tone": "joke"}}
                    ]
                  }
                ]
              }
            },
            "packing": {
              "on": {"DAY": {"target": "convening"}}
            },
            "convening": {
              "entry": [
                {"type": "building.ensure", "params": {"kind": "manor"}},
                {"type": "building.lights", "params": {"building": "manor", "off": true, "hours": 10}},
                {"type": "camera.beat", "params": {"kind": "fade", "on": "manor", "kicker": "Later that evening, at Utilsbury Manor", "caption": "The lights go off at 11:04pm, exactly as scheduled.", "sub": "Breakout sessions are self-organising. Attendance is tracked in expected hugs.", "zoom": 1.5, "hold": 5}},
                {"type": "sound.cue", "params": {"cue": "mea.door"}},
                {"type": "toast", "params": {"text": "A door closes at Utilsbury Manor. The rota marks the room \"in session\".", "tone": "joke"}}
              ],
              "on": {"DAY": {"target": "sock", "guard": {"type": "after", "params": {"days": 1}}}}
            },
            "sock": {
              "entry": [
                {"type": "building.prop", "params": {"building": "cluster", "prop": "sock", "hours": 24}},
                {"type": "camera.beat", "params": {"kind": "fade", "on": "cluster", "kicker": "Meanwhile, back at {lab}", "caption": "Someone has hung a sock on the Cluster door.", "sub": "Training continues. The GPUs have seen worse.", "zoom": 1.6, "hold": 5}},
                {"type": "toast", "params": {"text": "The Cluster is \"in a meeting\". Please knock, then update the spreadsheet.", "tone": "joke"}}
              ],
              "on": {"DAY": {"target": "leaked", "guard": {"type": "after", "params": {"days": 1}}}}
            },
            "leaked": {
              "entry": [
                {"type": "building.ensure", "params": {"kind": "manor"}},
                {"type": "card", "params": {"id": "mea-leak"}},
                {"type": "trust.delta", "params": {"amount": -8}},
                {"type": "news", "params": {"text": "LEAKED: a Sankey chart of the Utilsbury Convening, in expected hugs; analysts call the Hot Tub band \"material\"", "tone": "bad"}},
                {"type": "sound.cue", "params": {"cue": "card"}}
              ],
              "on": {
                "CHOSE": [
                  {
                    "target": "pileon",
                    "guard": {"type": "choice", "params": {"is": "0", "card": "mea-leak"}},
                    "actions": [
                      {"type": "trust.delta", "params": {"amount": -4}},
                      {"type": "hype.delta", "params": {"amount": 6}},
                      {"type": "news", "params": {"text": "{lab} says the leaked Sankey is \"a seating chart\"; seating chart has a Hot Tub", "tone": "joke"}}
                    ]
                  },
                  {
                    "target": "pileon",
                    "guard": {"type": "choice", "params": {"is": "1", "card": "mea-leak"}},
                    "actions": [
                      {"type": "trust.delta", "params": {"amount": 3}},
                      {"type": "hype.delta", "params": {"amount": 10}},
                      {"type": "news", "params": {"text": "{lab} publishes the Sankey's methodology; Appendix Q, \"What Counts As A Hug\", tops the charts", "tone": "joke"}}
                    ]
                  },
                  {
                    "target": "pileon",
                    "guard": {"type": "choice", "params": {"is": "2", "card": "mea-leak"}},
                    "actions": [
                      {"type": "vibes.delta", "params": {"amount": 30}},
                      {"type": "trust.delta", "params": {"amount": -2}},
                      {"type": "news", "params": {"text": "{lab} commissions a Sankey of the Sankey; the widest band is \"people sharing the Sankey\"", "tone": "joke"}}
                    ]
                  }
                ]
              }
            },
            "pileon": {
              "entry": [
                {"type": "birdapp.post", "params": {"archetype": "thread", "outcome": "controversy", "text": "1/ I have read the leaked Sankey so you don't have to. 2/ You should read the Sankey."}},
                {"type": "birdapp.post", "params": {"archetype": "doomer", "outcome": "ratioed", "text": "The real alignment problem was the rooming spreadsheet all along."}},
                {"type": "birdapp.post", "params": {"archetype": "hype", "outcome": "banger", "text": "we were in the Library the whole time. the Library was amazing. huge if true"}},
                {"type": "birdapp.rival", "params": {"role": "ceo", "outcome": "banger", "text": "We also convene. In a conference room. With the lights on."}},
                {"type": "toast", "params": {"text": "The Sankey is on the Bird App. Your posters have opinions about the Hot Tub band.", "tone": "bad"}}
              ],
              "on": {"DAY": {"target": "crisis", "guard": {"type": "after", "params": {"days": 1}}}}
            },
            "crisis": {
              "entry": [
                {"type": "card", "params": {"id": "mea-statement"}},
                {"type": "news", "params": {"text": "Senate subcommittee asks {lab} to define \"convening\" under oath; {lab} requests a whiteboard", "tone": "neutral"}},
                {"type": "sound.cue", "params": {"cue": "card"}}
              ],
              "on": {
                "CHOSE": [
                  {
                    "target": "done",
                    "guard": {"type": "choice", "params": {"is": "0", "card": "mea-statement"}},
                    "actions": [
                      {"type": "trust.delta", "params": {"amount": 4}},
                      {"type": "hype.delta", "params": {"amount": -2}},
                      {"type": "news", "params": {"text": "{lab} statement on the Convening is \"a statement\", say people who read statements", "tone": "neutral"}}
                    ]
                  },
                  {
                    "target": "done",
                    "guard": {"type": "choice", "params": {"is": "1", "card": "mea-statement"}},
                    "actions": [
                      {"type": "trust.delta", "params": {"amount": 2}},
                      {"type": "hype.delta", "params": {"amount": 3}},
                      {"type": "news", "params": {"text": "{lab} statement footnote has a footnote; the footnote's footnote gets its own Sankey", "tone": "joke"}}
                    ]
                  },
                  {
                    "target": "done",
                    "guard": {"type": "choice", "params": {"is": "2", "card": "mea-statement"}},
                    "actions": [
                      {"type": "vibes.delta", "params": {"amount": 40}},
                      {"type": "trust.delta", "params": {"amount": -3}},
                      {"type": "news", "params": {"text": "{lab} Comms Desk logs off; statement goes out as a Sankey with one band labelled \"no comment\"", "tone": "joke"}}
                    ]
                  }
                ]
              }
            },
            "done": {
              "type": "final",
              "entry": [
                {"type": "toast", "params": {"text": "The next Convening is pencilled in. The rota is already on version three.", "tone": "joke"}}
              ]
            }
          }
        }
      ]
    },
    "headlines": {
      "add": [
        {"id": "mea-head-1", "text": "Maximally Effective Altruists announce a Convening; the schedule has a column for vibes (projected)", "tone": "joke"},
        {"id": "mea-head-2", "text": "Utilsbury Manor files its Hot Tub as \"wellbeing infrastructure\"; filing cleared review", "tone": "joke"},
        {"id": "mea-head-3", "text": "Study: longtermist couples plan dates 500 years ahead, still late for dinner", "tone": "joke"},
        {"id": "mea-head-4", "text": "Polycule org chart enters its fourth revision; now has a dotted line to the cat", "tone": "joke"},
        {"id": "mea-head-5", "text": "Local utilitarian proves the Hot Tub is net positive; the proof is mostly bubbles", "tone": "joke"},
        {"id": "mea-head-6", "text": "Convening attendees asked to rank their priors, out loud, in the Orangery", "tone": "joke"}
      ]
    },
    "thoughts": {
      "add": [
        {"id": "mea-th-1", "kind": "researcher", "when": "always", "text": "I ran the EV on lunch. Lunch wins, but only in expectation."},
        {"id": "mea-th-2", "kind": "researcher", "when": "always", "text": "We're longtermist. We'll see where things are in 500 years."},
        {"id": "mea-th-3", "kind": "researcher", "when": "always", "text": "Our relationship has a theory of change now. It's mostly a Gantt chart."},
        {"id": "mea-th-4", "kind": "researcher", "when": "always", "text": "I put the Hot Tub in the budget as wellbeing infrastructure. It cleared review."},
        {"id": "mea-th-5", "kind": "researcher", "when": "always", "text": "Is the Convening this weekend? I've pre-registered my hugs."},
        {"id": "mea-th-6", "kind": "researcher", "when": "always", "text": "Utilsbury Manor has a rota for the rota."},
        {"id": "mea-th-7", "kind": "researcher", "when": "always", "text": "I tried to schedule a spontaneous moment. Next free slot is Q3."},
        {"id": "mea-th-8", "kind": "researcher", "when": "night", "text": "The lights at the manor just went out. Right on schedule."},
        {"id": "mea-th-9", "kind": "visitor", "when": "always", "text": "I came for the tour and got invited to a Convening. Declining, with error bars."}
      ]
    }
  }

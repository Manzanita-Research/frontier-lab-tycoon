          "stripe": "Comms Desk · Crisis",
          "tone": "bad",
          "cooldown": 0,
          "when": {"flag": "mea:never", "daysAgo": 0},
          "title": "The Comms Desk has drafted a statement.",
          "body": "Fourteen drafts in. Draft fourteen is mostly footnotes. The Comms Desk would like to send it and log off.",
          "doc": {
            "style": "email",
            "file": "statement_DRAFT_14.eml",
            "subject": "RE: RE: RE: the Sankey (statement, FINAL)",

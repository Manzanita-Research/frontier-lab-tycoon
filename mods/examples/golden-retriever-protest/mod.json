  "skin": {
    "id": "good-boy-95",
    "name": "Good Boy 95",
    "extends": "frontier-95",
    "activate": true,
    "author": "The Good Boy Collective",
    "description": "Frontier 95, but golden. The Start menu fetches.",
    "tokens": {
      "color.bg": "#6fae5a",
      "color.titlebar": "#b8752a",
      "color.accent": "#b8752a",

              }
            }
          ],
          "fail": [
            {
              "type": "news",
              "params": {
                "text": "Senate votes to keep writing its own bills; the bills remain exactly as good",
                "tone": "joke"
              }
            },
            {
              "type": "capture.delta",
              "params": {
                "amount": -4
              }
            },
            {
              "type": "faction.delta",
              "params": {
                "faction": "wonks",
                "amount": 8,
                "text": "The Senate will keep writing its own bills"
              }
            }
          ]
        },
        {
          "id": "deepfake",
          "title": "The Deepfake Senator Protection Act",
          "summary": "Deepfakes are banned. Of senators. Everyone else is \"a matter for the states\".",
          "labSide": "nay",
          "stakes": {
            "pass": "Hype −6 for your demo reel (it had a senator in it); Heat +3",
            "fail": "Trust −4; a deepfake of the chair goes viral"
          },
          "promises": {
            "blusterworth": {
              "says": "aye",
              "line": "promises to protect voters from \"the fake me\", specifically"

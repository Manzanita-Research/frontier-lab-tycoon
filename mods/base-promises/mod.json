        {
          "id": "compute",
          "title": "The Public Compute For Everyone Act",
          "summary": "Free compute for universities, served by {lab}'s datacenters at list price.",
          "labSide": "aye",
          "stakes": {
            "pass": "$250K at list price, Trust +4; the Open Weights crowd cheers",
            "fail": "The Open Weights crowd blames you, personally"
          },
          "promises": {
            "blusterworth": {
              "says": "aye",

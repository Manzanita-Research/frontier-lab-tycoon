{
  "name": "frontier-lab-tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && pnpm --filter @flt/mod-sdk typecheck",
    "test": "vitest run && node --test packages/flt-mod-cli/*.test.mjs drama/*.test.mjs scripts/infra-guard.test.mjs",
    "test:watch": "vitest",
    "check": "pnpm guard && pnpm typecheck && pnpm test && pnpm build",
    "guard": "node scripts/infra-guard.mjs",
    "shot": "node scripts/shot.mjs",
    "mod:check": "node scripts/flt-mod-check.mjs",
    "flt-mod": "node packages/flt-mod-cli/cli.mjs",
    "create-mod": "node packages/flt-mod-cli/create.mjs",
    "modkit:check": "pnpm --filter @flt/mod-sdk typecheck && node --test packages/flt-mod-cli/*.test.mjs",
    "shots": "node scripts/shots.mjs",
    "e2e:stranger": "node e2e/stranger.mjs",
    "e2e:journey": "node e2e/journey.mjs",
    "e2e:coach": "node e2e/coach-overlap.mjs",
    "e2e:drama": "node e2e/drama.mjs",
    "e2e:accounts": "node e2e/accounts.mjs",
    "drama": "node scripts/drama-run.mjs",
    "drama:lint": "node drama/lint.mjs"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.118",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "3.1.3",
    "@xstate/effect": "0.1.0-alpha.5",
    "better-auth": "1.7.6",
    "effect": "4.0.0-rc.118",
    "postprocessing": "6.39.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "scheduler": "0.27.0",
    "three": "^0.180.0",
    "xstate": "6.0.0-alpha.62"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@effect/vitest": "4.0.0-rc.118",
    "@flt/mod-cli": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "overrides": {
      "undici@^7": ">=7.29.1 <8",
      "sharp@^0.35": ">=0.35.4 <0.36"
    }
  }
}

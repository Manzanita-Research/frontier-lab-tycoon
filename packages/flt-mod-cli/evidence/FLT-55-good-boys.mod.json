        {"shape": "sphere", "size": [0.08, 0.07, 0.07], "at": [0, 0.78, 0.77], "color": "#221710", "pivot": [0, -0.1, -0.43], "motion": "nod"},
        {"shape": "box", "size": [0.08, 0.24, 0.14], "at": [0.19, 0.76, 0.42], "color": "coat", "shade": -0.3, "pivot": [0, 0.1, 0], "motion": "flop"},

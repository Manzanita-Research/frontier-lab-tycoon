  "audio": {
    "cues": {
      "good.woof": [
        {"at": 0, "hz": 320, "endHz": 520, "duration": 0.05, "gain": 0.12, "wave": "sawtooth"},
        {"at": 0.05, "hz": 520, "endHz": 220, "duration": 0.12, "gain": 0.12, "wave": "square"}
      ],
      "protest.grow": [
        {"at": 0, "hz": 320, "endHz": 520, "duration": 0.05, "gain": 0.12, "wave": "sawtooth"},
        {"at": 0.05, "hz": 520, "endHz": 220, "duration": 0.12, "gain": 0.12, "wave": "square"},
        {"at": 0.25, "hz": 340, "endHz": 540, "duration": 0.05, "gain": 0.12, "wave": "sawtooth"},
        {"at": 0.3, "hz": 540, "endHz": 230, "duration": 0.12, "gain": 0.12, "wave": "square"}
      ]
    }
  },
  "content": {
    "progression": {
      "override": [
        {"id": "garage", "level": 1, "name": "Garage", "buildings": ["hall", "cluster"], "staff": [], "systems": ["protests"], "panels": [], "goal": {"text": "Ship your first model", "metric": "models", "target": 1}}
      ]
    },
    "thoughts": {
      "add": [
        {"id": "gb-1", "kind": "protester", "when": "always", "text": "Who's a good model? Not yours."},
        {"id": "gb-2", "kind": "protester", "when": "protest", "text": "Ball. BALL. Also, accountability."},
        {"id": "gb-3", "kind": "protester", "when": "always", "text": "I have sniffed your training data. Concerning."}
      ]
    },
    "headlines": {
      "add": [
        {"id": "gb-h1", "text": "Golden retrievers picket {lab}; demands include belly rubs and a pause", "tone": "joke"},
        {"id": "gb-h2", "trigger": "protest", "text": "Protest at {lab} escalates to coordinated tail-wagging", "tone": "joke"}
      ]
    },
    "arcs": {
      "add": [
        {"id": "gb-arrival", "initial": "waiting", "states": {
          "waiting": {"on": {"DAY": {"target": "picketing", "actions": [
            {"type": "discourse.delta", "params": {"amount": 16}},
            {"type": "toast", "params": {"text": "Good boys have arrived at the gate. They have demands.", "tone": "neutral"}},
            {"type": "sound.cue", "params": {"cue": "good.woof"}},
            {"type": "camera.focus", "params": {"on": "gate"}}
          ]}}},
          "picketing": {"type": "final"}
        }}
      ]
    }
  }

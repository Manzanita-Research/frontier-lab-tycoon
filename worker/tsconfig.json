{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["**/*.ts", "../src/account/contract.ts", "../src/introRoute.ts"],
  "exclude": ["**/*.test.ts", "harness.ts", "dev.ts"]
}
